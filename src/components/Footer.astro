---
import { FIND_PATH, LORE_PATH, SITE } from '../site';
import Logo from './Logo.astro';

const groups = [
  {
    title: 'Play',
    links: [
      { href: FIND_PATH, label: 'Find Tung Tung Tung Sahur' },
      { href: `${FIND_PATH}#modes`, label: 'Game Modes' },
      { href: '/games', label: 'All Games' },
    ],
  },
  {
    title: 'Site',
    links: [
      { href: LORE_PATH, label: 'Who Is He?' },
      { href: '/about', label: 'About' },
      { href: `${FIND_PATH}#faq`, label: 'FAQ' },
      { href: '/privacy', label: 'Privacy' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-hairline">
  <div class="mx-auto grid max-w-page gap-10 px-4 py-16 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="inline-flex items-center gap-2.5 rounded-sm font-semibold tracking-[-0.4px]">
        <Logo class="size-7" />
        <span translate="no">{SITE.name}</span>
      </a>
      <p class="mt-4 text-sm text-body">
        Free browser games starring the internet’s favorite wooden drummer. No downloads, no accounts.
      </p>
    </div>
    {
      groups.map((group) => (
        <div>
          <h2 class="eyebrow">{group.title}</h2>
          <ul class="mt-2 space-y-0.5">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="-mx-2 inline-block rounded-sm px-2 py-2 text-sm text-body transition-colors hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-hairline">
    <div
      class="mx-auto flex max-w-page flex-col gap-2 px-4 py-6 text-xs text-mute sm:flex-row sm:items-center sm:justify-between sm:px-6"
    >
      <p>© {year} <span translate="no">{SITE.domain}</span></p>
      <p>Fan-made and unofficial. All artwork is original.</p>
    </div>
  </div>
</footer>
