---
import type { GameIconName } from '../site';

interface Props {
  name: GameIconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<GameIconName, string> = {
  lantern:
    '<path d="M9 5h6M12 2v3"/><path d="M8 8h8l1 3v6l-1 3H8l-1-3v-6z"/><path d="M12 12.5c1.2 1 1.5 2 0 3.5-1.5-1.5-1.2-2.5 0-3.5z"/>',
  runner:
    '<circle cx="15" cy="4.5" r="2"/><path d="M13 21l2-6-3-3 2-4 3 3h3"/><path d="M10.5 9.5 8 10l-2 3"/><path d="m12 12-3 5H5"/>',
  rhythm:
    '<ellipse cx="12" cy="11" rx="8" ry="3"/><path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/><path d="m6 3 5 6M18 3l-5 6"/>',
  alarm:
    '<circle cx="12" cy="13" r="7"/><path d="M12 10v3l2 2"/><path d="M5 3 2.5 5.5M19 3l2.5 2.5M7 20l-1.5 2M17 20l1.5 2"/>',
  tap: '<path d="M9 11V5.5a1.5 1.5 0 0 1 3 0V11"/><path d="M12 10.5V9a1.5 1.5 0 0 1 3 0v2"/><path d="M15 11a1.5 1.5 0 0 1 3 0v3.5a6.5 6.5 0 0 1-6.5 6.5H11a5 5 0 0 1-4-2l-2.6-3.6a1.4 1.4 0 0 1 2.2-1.7L9 16"/><path d="M5 5.5a5 5 0 0 1 2-3"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
