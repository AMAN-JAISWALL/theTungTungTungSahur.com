---
import type { Crumb } from '../lib/schema';

interface Props {
  items: Crumb[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-mute">
    {
      items.map((item, i) => (
        <li class="flex min-w-0 items-center gap-1.5">
          {i > 0 && (
            <svg class="size-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m9 6 6 6-6 6" />
            </svg>
          )}
          {i === items.length - 1 ? (
            <span aria-current="page" class="truncate text-body">
              {item.label}
            </span>
          ) : (
            <a href={item.href} class="-my-1.5 inline-block rounded-sm py-1.5 transition-colors hover:text-ink">
              {item.label}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
