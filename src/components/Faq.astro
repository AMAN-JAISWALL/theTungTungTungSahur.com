---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<div class:list={['divide-y divide-hairline border-y border-hairline', className]}>
  {
    items.map((item) => (
      <details class="group">
        <summary class="flex list-none items-center justify-between gap-4 rounded-sm py-5 text-left [&::-webkit-details-marker]:hidden">
          <h3 class="text-base font-medium">{item.q}</h3>
          <svg
            class="size-4 shrink-0 text-mute transition-transform group-open:rotate-45"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M12 5v14M5 12h14" />
          </svg>
        </summary>
        <p class="max-w-3xl pb-5 text-body">{item.a}</p>
      </details>
    ))
  }
</div>
