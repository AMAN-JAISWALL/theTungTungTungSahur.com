---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pageGraph, type Crumb, type PageGraphOptions, type QuestionAnswer } from '../lib/schema';
import { SITE } from '../site';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** Canonical path without a trailing slash, e.g. "/games". */
  path: string;
  /** Social image path under /public. */
  image?: string;
  imageAlt?: string;
  /** Extra JSON-LD nodes merged into this page's @graph. */
  schema?: Record<string, unknown>[];
  /** Schema.org type for the page node. */
  pageType?: PageGraphOptions['type'];
  /** Rendered breadcrumb trail; also emits BreadcrumbList. */
  crumbs?: Crumb[];
  /** Questions rendered on the page; also emits FAQPage. */
  faq?: readonly QuestionAnswer[];
  /** Whether the page is about the meme character. */
  about?: boolean;
  datePublished?: string;
  dateModified?: string;
  ogType?: 'website' | 'article';
  /**
   * Drop the page from the index and skip its canonical and JSON-LD — for the error pages, which
   * stand in for a URL rather than being one. Crawlers still `follow` the links out of them.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  image = '/og/default.png',
  imageAlt = 'Tung Tung Tung Sahur, a wooden log with a bat, standing in a village at night.',
  schema = [],
  pageType,
  crumbs,
  faq,
  about,
  datePublished,
  dateModified,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;

// One graph per page: the shared nodes first, then whatever the page adds.
const graph = noindex
  ? []
  : [
      ...pageGraph({ type: pageType, path, name: title, description, image, crumbs, faq, about, datePublished, dateModified }),
      ...schema,
    ];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex, follow" />
      ) : (
        <Fragment>
          <link rel="canonical" href={canonical} />
          <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
        </Fragment>
      )
    }

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png?v=2" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta name="apple-mobile-web-app-title" content="Sahur" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <Font cssVariable="--font-geist" preload={[{ weight: '400' }, { weight: '600' }]} />
    <Font cssVariable="--font-geist-mono" />

    {
      graph.length > 0 && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip">
    <a
      href="#main"
      class="sr-only z-50 rounded-sm bg-ink px-3 py-2 text-sm font-medium text-on-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to Content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
