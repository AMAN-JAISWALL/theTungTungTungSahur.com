---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** Canonical path without a trailing slash, e.g. "/games". */
  path: string;
  /** Social image path under /public. */
  image?: string;
  imageAlt?: string;
  /** JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  image = '/og/default.png',
  imageAlt = 'Tung Tung Tung Sahur, a wooden log with a bat, standing in a village at night.',
  schema = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;
const imageUrl = new URL(image, SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={SITE.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <Font cssVariable="--font-geist" preload={[{ weight: '400' }, { weight: '600' }]} />
    <Font cssVariable="--font-geist-mono" />

    {
      schema.map((item) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />
      ))
    }
  </head>
  <body class="flex min-h-dvh flex-col overflow-x-clip">
    <a
      href="#main"
      class="sr-only z-50 rounded-sm bg-ink px-3 py-2 text-sm font-medium text-on-ink focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to Content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
