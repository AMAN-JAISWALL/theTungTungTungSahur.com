---
import Layout from '../layouts/Layout.astro';
import ErrorPage from '../components/ErrorPage.astro';
import { FIND_PATH } from '../site';
---

<Layout
  title="Page Not Found (404) | The Tung Tung Tung Sahur"
  description="That page doesn’t exist on thetungtungtungsahur.com. Go back to the hub, play Find Tung Tung Tung Sahur, or pick up the trail from the games list, the character page or the FAQ."
  path="/404"
  noindex
>
  <ErrorPage
    code={404}
    eyebrow="Error 404"
    title="He’s Not Hiding Here"
    lead="This page doesn’t exist, or it moved while you weren’t listening. Check the address for a typo, or follow the knocking back to something that does."
    cta={{ href: `${FIND_PATH}#play`, label: 'Play the Game' }}
  />
</Layout>
