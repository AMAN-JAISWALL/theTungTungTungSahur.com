---
import Layout from '../layouts/Layout.astro';
import NightScene from '../components/NightScene.astro';
import { FIND_PATH } from '../site';
---

<Layout
  title="Page Not Found | The Tung Tung Tung Sahur"
  description="This page doesn’t exist. Head back to the Tung Tung Tung Sahur game hub."
  path="/404"
  noindex
>
  <section class="relative isolate overflow-hidden">
    <NightScene id="lost" stars={60} class="-z-10" />
    <div class="mx-auto flex min-h-[70dvh] max-w-xl flex-col items-center justify-center px-4 pt-16 pb-44 text-center">
      <span class="glow-eyes relative! [transform:none]! [--eye-size:12px]" aria-hidden="true"><i></i><i></i></span>
      <p class="eyebrow mt-8">Error 404</p>
      <h1 class="mt-3 text-display-sm sm:text-display">He’s Not Hiding Here</h1>
      <p class="mt-4 text-body">This page doesn’t exist. Try listening somewhere else.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`${FIND_PATH}#play`} class="btn btn-pill btn-primary">Play the Game</a>
        <a href="/" class="btn btn-pill btn-secondary">Back to the Hub</a>
      </div>
    </div>
  </section>
</Layout>
