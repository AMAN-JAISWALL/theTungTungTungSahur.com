---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import NightScene from '../components/NightScene.astro';
import Sahur from '../components/Sahur.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import { absolute } from '../lib/schema';
import { CONTACT_PATH, FAQ_PATH, FIND_PATH, LIVE_GAMES, LORE_PATH, SITE_PAGES, SOON_GAMES } from '../site';

const itemList = {
  '@type': 'ItemList',
  '@id': `${absolute('/')}#games`,
  name: 'Tung Tung Tung Sahur games',
  itemListElement: LIVE_GAMES.map((game, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: game.name,
    url: absolute(game.href!),
  })),
};

const reasons = [
  { title: 'Free, With No Catch', body: 'No paywall, no ads, no account and no email. Click Play and you’re in.' },
  { title: 'Nothing to Download', body: 'There’s no app, no APK and no install. The games are web pages that start in a click.' },
  { title: 'Original Artwork', body: 'Every drawing on this site was made for it. Nothing is lifted from someone else’s game.' },
  { title: 'Sound Made Live', body: 'Every knock, klang and fanfare is synthesized in your browser with the Web Audio API.' },
  { title: 'Playable Muted', body: 'Visual cues stand in for the audio, with screen reader announcements and reduced-motion support.' },
  { title: 'Your Progress Stays Here', body: 'Scores and streaks save to your browser. No accounts, no ads and nothing synced to a server.' },
];

const faqs: FaqItem[] = [
  {
    q: 'Is There a Free Tung Tung Tung Sahur Game Online?',
    a: 'Yes. Every game on this site is free to play in a browser, with no account and no download. The one that’s live right now is Find Tung Tung Tung Sahur, a hide-and-seek game you play by ear: follow the drumming through a dark village and catch him before sunrise.',
  },
  {
    q: 'Do I Need to Download Anything?',
    a: 'No. There’s no app, no APK and nothing to install. The whole game is a web page, and the sound is generated in your browser rather than downloaded as audio files, so the first knock plays almost instantly.',
  },
  {
    q: 'Does It Work on Phones, Tablets and School Chromebooks?',
    a: 'Yes. It runs in any modern browser on Android, iOS, Windows, macOS and ChromeOS, with mouse, touch and keyboard controls. It’s a single static page with no plugins, so it works on locked-down school Chromebooks wherever the network allows the site.',
  },
  {
    q: 'Is the Tung Tung Tung Sahur Game Scary?',
    a: 'Not really. It’s set at night and it gets tense when the drumming speeds up, but there are no jumpscares, no gore and nothing chasing you. If you came looking for the survival horror games built around this meme, this isn’t one of them.',
  },
  {
    q: 'Is This the Official Tung Tung Tung Sahur Game?',
    a: 'No. This is an independent, fan-made site. It isn’t affiliated with the creator of the meme, and it isn’t connected to the horror, clicker, obby or shooter games hosted on other sites.',
  },
];
---

<Layout
  title="Tung Tung Tung Sahur Game: Play Free Online, No Download"
  description="Free Tung Tung Tung Sahur games in your browser, with no download. Follow his drumming through the dark and catch him before dawn. Works on phones and PC."
  path="/"
  faq={faqs}
  schema={[itemList]}
>
  <section class="relative isolate overflow-hidden border-b border-hairline">
    <NightScene id="hero" stars={80} class="-z-20" />
    <div class="hero-shade absolute inset-0 -z-10" aria-hidden="true"></div>

    <div
      class="mx-auto grid max-w-page items-center gap-6 px-4 pt-14 pb-36 sm:px-6 sm:pb-44 md:pt-24 lg:grid-cols-[1.15fr_1fr] lg:pb-56"
    >
      <div>
        <p class="eyebrow">Game Hub · Free · No Download</p>
        <h1 class="mt-5 text-display-sm sm:text-display lg:text-display-lg">
          <span class="knock">Tung</span>{' '}
          <span class="knock">Tung</span>{' '}
          <span class="knock">Tung</span>{' '}
          <span class="knock">Sahur</span>{' '}
          {/* No .knock here: that rule sets inline-block and would beat this span's `block`. */}
          <span class="block text-body">Games, after&nbsp;dark.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-body">
          Free browser games starring the internet’s favorite wooden drummer. Nothing to download, no account, no ads,
          and they play on phones, tablets and PCs. The first one is live: he’s hiding in the dark, and all you have is
          a lantern and your ears.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`${FIND_PATH}#play`} class="btn btn-pill btn-primary">
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>
            Play Find Tung Tung Tung Sahur
          </a>
          <a href="#games" class="btn btn-pill btn-secondary">Browse Games</a>
        </div>
        <p class="mt-5 flex items-center gap-2 text-sm text-mute">
          <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"></path>
          </svg>
          Best with sound. Plays on phones, tablets and desktops.
        </p>
      </div>

      <div class="hero-art relative mx-auto w-full max-w-[420px]" aria-hidden="true">
        <div class="hero-glow"></div>
        <Sahur class="hero-sahur relative mx-auto w-[54%] min-w-44" mood="idle" />
        <span class="hero-word left-[6%] top-[18%]">tung</span>
        <span class="hero-word right-[4%] top-[8%]" style="--d: 1.25s">tung</span>
        <span class="hero-word is-hot right-[10%] top-[52%]" style="--d: 1.6s">TUNG!</span>
      </div>
    </div>
  </section>

  <section id="games" aria-labelledby="games-title" class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">The Games</p>
        <h2 id="games-title" class="mt-3 text-heading-lg">One Live, More on the Way</h2>
        <p class="mt-3 max-w-xl text-body">Short, free and made for any screen. New games join the hub as they’re ready.</p>
      </div>
      <a href="/games" class="link -my-1.5 inline-block shrink-0 py-1.5 text-sm font-medium">View All Games →</a>
    </div>
    <div class="mt-10 grid gap-4">
      {LIVE_GAMES.map((game, i) => <GameCard game={game} index={i + 1} />)}
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {SOON_GAMES.map((game, i) => <GameCard game={game} index={LIVE_GAMES.length + i + 1} />)}
      </div>
    </div>
  </section>

  <section aria-labelledby="why-title" class="mx-auto max-w-page px-4 pb-20 sm:px-6 md:pb-28">
    <p class="eyebrow">Why Play Here</p>
    <h2 id="why-title" class="mt-3 text-heading-lg">A Fan Game, Not a Game Portal</h2>
    <p class="mt-3 max-w-xl text-body">
      There are dozens of Tung Tung Tung Sahur games scattered across ad-heavy portals. These are ours, made from
      scratch.
    </p>
    <ul class="mt-10 grid gap-px overflow-hidden rounded-md border border-hairline bg-hairline sm:grid-cols-2 lg:grid-cols-3">
      {
        reasons.map((reason) => (
          <li class="bg-canvas p-6">
            <h3 class="text-label">{reason.title}</h3>
            <p class="mt-1 text-sm text-body">{reason.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="legend-title" class="border-y border-hairline bg-elevated/50">
    <div class="mx-auto grid max-w-page gap-8 px-4 py-20 sm:px-6 md:grid-cols-[1fr_1.3fr] md:gap-16 md:py-28">
      <div>
        <p class="eyebrow">The Legend</p>
        <h2 id="legend-title" class="mt-3 text-heading-lg">Who Is Tung Tung Tung Sahur?</h2>
      </div>
      <div class="space-y-4 text-body md:text-lg">
        <p>
          Tung Tung Tung Sahur is an AI-generated meme character posted on 28 February 2025 by the Indonesian TikTok user
          Fernanda Bagas Indrastata, who goes by Noxa. He’s a <em>kentongan</em> — the hollow wooden slit drum that
          neighbourhoods across Indonesia bang to wake everyone for sahur, the meal eaten before dawn during Ramadan —
          given a face, two thin legs and a bat.
        </p>
        <p>
          His name is just the sound he makes. Tung, tung, tung: three knocks. The lore says that if you’re called for
          sahur three times and you still don’t answer, he turns up at your house. That one joke carried him off
          Indonesian TikTok and into “Italian brainrot”, the wave of absurd AI characters he now shares a stage with.
        </p>
        <p>
          Which makes him an unusual thing to build a game around, because the character <em>is</em> a drum. The
          meme <em>is</em> a sound. So we made a game you play with your ears.
        </p>
        <p class="flex flex-col gap-1 text-base sm:flex-row sm:gap-5">
          <a class="link font-medium" href={LORE_PATH}>Read the full story →</a>
          <a class="link font-medium" href={FIND_PATH}>Play Find Tung Tung Tung Sahur →</a>
        </p>
      </div>
    </div>
  </section>

  <section id="faq" aria-labelledby="faq-title" class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
    <div class="grid gap-8 md:grid-cols-[1fr_2fr] md:gap-16">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 id="faq-title" class="mt-3 text-heading-lg">Common Questions</h2>
        <p class="mt-3 text-body">
          More about the game itself on the <a class="link" href={`${FIND_PATH}#faq`}>Find Tung Tung Tung Sahur page</a>,
          or see <a class="link" href={FAQ_PATH}>every question about the meme and the games</a>.
        </p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <section id="site" aria-labelledby="site-title" class="border-t border-hairline">
    <div class="mx-auto max-w-page px-4 py-20 sm:px-6 md:py-28">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="eyebrow">The Site</p>
          <h2 id="site-title" class="mt-3 text-heading-lg">Who Runs This, and the Fine Print</h2>
          <p class="mt-3 max-w-xl text-body">
            An independent fan project rather than a game portal. Here’s who makes it, how to reach them, what happens
            to your data and the terms you’re playing under.
          </p>
        </div>
        <a href={CONTACT_PATH} class="link -my-1.5 inline-block shrink-0 py-1.5 text-sm font-medium">Contact Us →</a>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          SITE_PAGES.map((page) => (
            <li>
              <a
                href={page.href}
                class="card group flex h-full flex-col p-6 transition-colors hover:border-[#343a4d] hover:bg-raised"
              >
                <h3 class="flex items-center justify-between gap-3 text-heading-md">
                  {page.label}
                  <svg
                    class="size-4 shrink-0 text-mute transition-transform group-hover:translate-x-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                </h3>
                <p class="mt-2 text-sm text-body">{page.blurb}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="cta-title" class="relative isolate overflow-hidden">
    <div class="mesh-night absolute inset-x-0 -bottom-28 -z-10 h-72 opacity-80" aria-hidden="true"></div>
    <div class="mx-auto max-w-page px-4 py-24 text-center sm:px-6 md:py-32">
      <p class="font-mono text-sm text-lantern" aria-hidden="true">tung · tung · tung</p>
      <h2 id="cta-title" class="mt-4 text-display-sm sm:text-display">He’s Already Hiding.</h2>
      <p class="mx-auto mt-4 max-w-md text-body">Put your headphones on and see how fast you can find him.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={`${FIND_PATH}#play`} class="btn btn-pill btn-primary">Start Playing</a>
        <a href={`${FIND_PATH}?mode=daily#play`} class="btn btn-pill btn-secondary">Today’s Daily Sahur</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-shade {
    background:
      linear-gradient(90deg, rgb(3 4 10 / 0.72), rgb(3 4 10 / 0.25) 55%, transparent),
      radial-gradient(60% 50% at 20% 30%, rgb(0 124 240 / 0.12), transparent 70%);
  }
  .hero-art {
    padding-top: 28px;
  }
  .hero-glow {
    position: absolute;
    inset: 4% 14% 0;
    background: radial-gradient(circle at 50% 55%, rgb(255 181 71 / 0.3), transparent 62%);
    filter: blur(8px);
  }
  /* The character is a child component, so reach it through :global(). */
  .hero-art :global(.hero-sahur) {
    transform-origin: 50% 95%;
    filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.55));
    animation: hero-bonk 1.1s cubic-bezier(0.3, 1.4, 0.5, 1) 0.9s 2 both;
  }
  .hero-word {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-body);
    animation: hero-word 1.1s ease-out var(--d, 0.9s) 3 both;
  }
  .hero-word.is-hot {
    color: var(--color-lantern);
  }
  .knock {
    display: inline-block;
    animation: knock 520ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
  }
  .knock:nth-child(2) {
    animation-delay: 150ms;
  }
  .knock:nth-child(3) {
    animation-delay: 300ms;
  }
  .knock:nth-child(4) {
    animation-delay: 450ms;
  }
  @keyframes knock {
    from {
      opacity: 0;
      transform: translateY(-18px) rotate(-4deg);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-bonk {
    0%,
    100% {
      transform: none;
    }
    30% {
      transform: rotate(-5deg) translateY(-6px);
    }
    60% {
      transform: rotate(3deg);
    }
  }
  @keyframes hero-word {
    0% {
      opacity: 0;
      transform: translateY(6px) scale(0.9);
    }
    25% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
</style>
