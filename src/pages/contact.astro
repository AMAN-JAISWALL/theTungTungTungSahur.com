---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Sahur from '../components/Sahur.astro';
import { type Crumb } from '../lib/schema';
import { ABOUT_PATH, CONTACT_EMAIL, CONTACT_PATH, FAQ_PATH, FIND_PATH, PRIVACY_PATH, SITE, TERMS_PATH } from '../site';

const crumbs: Crumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: CONTACT_PATH },
];

/** A pre-filled subject line saves a round trip asking what the message is about. */
const mailto = (subject: string) => `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}`;

const reasons = [
  {
    title: 'A Bug in a Game',
    body: 'Something froze, the sound cut out, a score saved wrong, or the lantern went somewhere it shouldn’t. These get fixed fastest.',
    subject: 'Bug report — Find Tung Tung Tung Sahur',
    cta: 'Report a bug',
  },
  {
    title: 'An Idea for a Game',
    body: 'A mode you’d like, a mechanic worth stealing, or one of the games listed as coming soon that you want bumped up the queue.',
    subject: 'Game idea for The Tung Tung Tung Sahur',
    cta: 'Send an idea',
  },
  {
    title: 'Something Hard to Use',
    body: 'A control that won’t reach, text too small, a screen reader reading it wrong, or motion that makes you queasy. Accessibility reports are treated as bugs, not requests.',
    subject: 'Accessibility issue on The Tung Tung Tung Sahur',
    cta: 'Report an issue',
  },
  {
    title: 'Rights, Press or Featuring a Game',
    body: 'A copyright or trademark concern, a takedown request, an interview, or a plan to feature one of these games somewhere.',
    subject: 'Rights / press enquiry — thetungtungtungsahur.com',
    cta: 'Get in touch',
  },
];

const bugChecklist = [
  'Which game and which mode (Classic, Sahur Rush or Daily Sahur)',
  'Your device and browser — “iPhone, Safari” is plenty',
  'What you did, what you expected, and what happened instead',
  'A screenshot or a short screen recording, if you have one',
];

const cannotHelp = [
  {
    q: 'The horror, obby or clicker game you were playing',
    a: 'If it wasn’t on this domain, it isn’t ours. Dozens of Tung Tung Tung Sahur games are made by unrelated developers on portals, app stores and Roblox, and we have no access to them, their accounts or their support.',
  },
  {
    q: 'Steal a Brainrot, Roblox or Fortnite',
    a: 'We’re not the developer, the publisher or the agency in that dispute, and we can’t restore an item, refund a purchase or say when he’s coming back. <a href="/faq#steal-a-brainrot">The FAQ has what’s actually known</a>.',
  },
  {
    q: 'Licensing the character',
    a: 'We don’t own Tung Tung Tung Sahur and can’t grant rights to him. Who does own him is being decided in court — <a href="/faq#origin">the FAQ covers where that stands</a>.',
  },
  {
    q: 'Lost scores or a reset streak',
    a: 'Progress is saved only in your own browser, so clearing site data or switching devices erases it, and there’s no copy anywhere to restore. <a href="/privacy">The privacy policy explains why</a>.',
  },
];
---

<Layout
  title="Contact Us | The Tung Tung Tung Sahur"
  description={`Get in touch with ${SITE.name}: report a bug in the game, suggest a feature, or send a press or rights enquiry. One inbox, answered by the person who built the site.`}
  path={CONTACT_PATH}
  pageType="ContactPage"
  crumbs={crumbs}
  about={false}
>
  <PageHeader
    eyebrow="Contact"
    title="Say Tung"
    lead="One person builds this site, and one inbox receives everything. Bugs, ideas, rights queries and plain hellos all land in the same place."
    crumbs={crumbs}
  />

  <div class="mx-auto max-w-page px-4 py-16 sm:px-6 md:py-20">
    <section aria-labelledby="email-title" class="card relative isolate overflow-hidden p-6 sm:p-10">
      <div
        class="absolute inset-0 -z-10 bg-[radial-gradient(60%_80%_at_85%_50%,rgb(255_181_71/0.12),transparent_70%)]"
        aria-hidden="true"
      >
      </div>
      <div class="grid items-center gap-8 md:grid-cols-[2fr_1fr]">
        <div>
          <p class="eyebrow">Email</p>
          <h2 id="email-title" class="mt-3 text-heading-lg">
            <a class="link font-mono break-all" href={mailto('Hello from thetungtungtungsahur.com')}>{CONTACT_EMAIL}</a>
          </h2>
          <p class="mt-4 max-w-xl text-body">
            There’s no contact form here on purpose. A form would mean loading somebody else’s script onto the page, and
            this site doesn’t run third-party scripts of any kind — so a plain email address it is.
          </p>
          <p class="mt-3 max-w-xl text-sm text-mute">
            Expect a reply within a few days. This is a side project, not a company with a support desk, so please be
            patient — and write in English if you can.
          </p>
        </div>
        <div class="relative hidden justify-self-center md:block" aria-hidden="true">
          <Sahur class="w-32" mood="shout" />
        </div>
      </div>
    </section>

    <section aria-labelledby="reasons-title" class="mt-16 md:mt-20">
      <p class="eyebrow">What to Write About</p>
      <h2 id="reasons-title" class="mt-3 text-heading-lg">Pick a Subject Line</h2>
      <p class="mt-3 max-w-xl text-body">
        Each of these opens your email app with the subject already filled in. It all goes to the same address, so use
        whichever is closest.
      </p>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          reasons.map((reason) => (
            <li class="card flex flex-col p-6">
              <h3 class="text-heading-md">{reason.title}</h3>
              <p class="mt-2 flex-1 text-sm text-body">{reason.body}</p>
              <a class="link mt-5 inline-block text-sm font-medium" href={mailto(reason.subject)}>
                {reason.cta} →
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="mt-16 grid gap-10 md:mt-20 md:grid-cols-2 md:gap-16">
      <section aria-labelledby="checklist-title">
        <h2 id="checklist-title" class="text-heading-md">Reporting a Bug? Include This</h2>
        <p class="mt-3 text-body">
          Most game bugs depend on the device, so a report without these takes a few emails to pin down:
        </p>
        <ul class="mt-5 space-y-3">
          {
            bugChecklist.map((item) => (
              <li class="flex gap-3 text-sm text-body">
                <svg
                  class="mt-0.5 size-4 shrink-0 text-lantern"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path d="m5 13 4 4L19 7" />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="cannot-title">
        <h2 id="cannot-title" class="text-heading-md">Things We Genuinely Can’t Help With</h2>
        <p class="mt-3 text-body">
          Most of the mail here is about somebody else’s game. Saying this plainly saves you the wait for a reply:
        </p>
        <dl class="mt-5 space-y-4">
          {
            cannotHelp.map((item) => (
              <div class="border-l-2 border-hairline pl-4">
                <dt class="text-label">{item.q}</dt>
                <dd
                  class="mt-1 text-sm text-body [&_a]:text-link [&_a]:underline-offset-4 [&_a:hover]:text-link-deep [&_a:hover]:underline"
                  set:html={item.a}
                />
              </div>
            ))
          }
        </dl>
      </section>
    </div>

    <section aria-labelledby="before-title" class="mt-16 md:mt-20">
      <div class="card p-6 sm:p-10">
        <p class="eyebrow">Before You Write</p>
        <h2 id="before-title" class="mt-3 text-heading-lg">The Answer Might Already Be Here</h2>
        <p class="mt-3 max-w-xl text-body">
          Around forty questions about the meme, the ownership dispute and the games are answered on this site already —
          including almost everything people email to ask.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={FAQ_PATH} class="btn btn-pill btn-primary">Read the FAQ</a>
          <a href={ABOUT_PATH} class="btn btn-pill btn-secondary">About This Site</a>
        </div>
        <p class="mt-6 text-sm text-mute">
          Your email is used to reply to you and nothing else — no list, no newsletter, no sharing. See the{' '}
          <a class="link" href={PRIVACY_PATH}>privacy policy</a> and the{' '}
          <a class="link" href={TERMS_PATH}>terms</a>, or just{' '}
          <a class="link" href={`${FIND_PATH}#play`}>go and find him</a>.
        </p>
      </div>
    </section>
  </div>
</Layout>
