---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { type Crumb } from '../lib/schema';
import { CONTACT_EMAIL, CONTACT_PATH, PRIVACY_PATH, SITE, TERMS_PATH } from '../site';

const updated = new Date(Date.UTC(2026, 8, 19));
const updatedLabel = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(updated);

const crumbs: Crumb[] = [
  { label: 'Home', href: '/' },
  { label: 'Privacy', href: PRIVACY_PATH },
];

interface Section {
  title: string;
  body: string;
  /** Outbound references — third-party notices and opt-outs, rendered under the body. */
  links?: { label: string; href: string }[];
}

const sections: Section[] = [
  {
    title: 'What’s Stored',
    body: 'Your game progress (finds, best scores, daily results, streaks and settings) is saved in your browser’s local storage. It never leaves your device and isn’t sent to any server.',
  },
  {
    title: 'Accounts and Advertising',
    body: 'There are no accounts, and the site doesn’t ask for your name, email or other personal information. There’s no advertising here, and nothing about you is ever sold or shared.',
  },
  {
    title: 'Analytics',
    body: 'The site uses Google Analytics and Microsoft Clarity to see which games people play and where they get stuck. Both set cookies. Between them they record the pages you visit, roughly where in the world you are, your device and browser, and — for Clarity — your clicks, taps and scrolling, so we can tell which parts of a game confuse people. Neither one captures what you type, and there’s nothing on the site to type into anyway.',
    links: [
      { label: 'Google privacy notice', href: 'https://policies.google.com/privacy' },
      { label: 'Google Analytics opt-out', href: 'https://tools.google.com/dlpage/gaoptout' },
      { label: 'Microsoft privacy statement', href: 'https://privacy.microsoft.com/privacystatement' },
    ],
  },
  {
    title: 'Sound and Vibration',
    body: 'Game sounds are generated in your browser. Nothing is recorded, and the site never asks for microphone access. Vibration only happens on devices that support it and can be turned off in the game settings.',
  },
  {
    title: 'Hosting',
    body: 'Like any website, the hosting provider may keep standard server logs, such as IP addresses and browser types, for security and reliability.',
  },
  {
    title: 'Deleting Your Data',
    body: 'Clear this site’s data in your browser settings to delete all saved progress along with the analytics cookies. Any tracker-blocking extension, or a browser that blocks trackers by default, stops the analytics above from loading at all.',
  },
  {
    title: 'Emailing Us',
    body: `If you write to ${CONTACT_EMAIL}, your address and message sit in that inbox so we can reply. They aren’t added to any list, shared or used for anything else.`,
  },
  {
    title: 'Changes',
    body: 'If the tools above change, or if advertising is ever added, this page will be updated first.',
  },
];
---

<Layout
  title="Privacy Policy | The Tung Tung Tung Sahur"
  description={`How ${SITE.name} handles your data: progress stays in your browser, with no accounts and no ads.`}
  path={PRIVACY_PATH}
  crumbs={crumbs}
  about={false}
  dateModified={updated.toISOString().slice(0, 10)}
>
  <PageHeader eyebrow="Legal" title="Privacy Policy" crumbs={crumbs}>
    <p class="mt-4 font-mono text-xs text-mute">
      Last updated <time datetime={updated.toISOString().slice(0, 10)}>{updatedLabel}</time>
    </p>
  </PageHeader>
  <div class="mx-auto max-w-3xl space-y-10 px-4 py-16 sm:px-6">
    {
      sections.map((section) => (
        <section>
          <h2 class="text-heading-md">{section.title}</h2>
          <p class="mt-3 text-body">{section.body}</p>
          {section.links && (
            <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
              {section.links.map((link) => (
                <a class="link" href={link.href} target="_blank" rel="nofollow noopener">
                  {link.label}
                </a>
              ))}
            </p>
          )}
        </section>
      ))
    }

    <section aria-labelledby="privacy-more-title" class="card p-6 sm:p-8">
      <h2 id="privacy-more-title" class="text-heading-md">Questions About Any of This?</h2>
      <p class="mt-3 text-body">
        <a class="link" href={CONTACT_PATH}>Ask</a> — it’s a short policy because there’s genuinely little to say. The{' '}
        <a class="link" href={TERMS_PATH}>terms & conditions</a> cover the rest of the small print.
      </p>
    </section>
  </div>
</Layout>
